# Copy to `.env` in the repository root and edit.  Every value below is optional;
# the defaults let the project boot with zero configuration on SQLite.

# ---- Django ---------------------------------------------------------------
DJANGO_SECRET_KEY=dev-only-insecure-key-change-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*
DJANGO_TIME_ZONE=Asia/Dhaka
# Comma-separated extra origins allowed for CORS/CSRF (e.g. a staging domain)
DJANGO_EXTRA_ORIGINS=

# ---- Database -------------------------------------------------------------
# sqlite (default) | mysql | postgres
DB_ENGINE=sqlite
# DB_NAME=waste_manager_db
# DB_USER=root
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=3306

# ---- Machine learning serving budget --------------------------------------
# Batch training is an offline management command; the request path only ever
# performs bounded incremental updates.
ML_CONTINUAL_ENABLED=true
ML_CONTINUAL_MAX_SAMPLES=256
ML_CONTINUAL_MAX_MS=40
ML_ALLOW_INLINE_TRAINING=false

# ---- Fleet ----------------------------------------------------------------
FLEET_CAPACITY_KG=6000
FLEET_SHIFT_MINUTES=480
FLEET_SERVICE_MINUTES=4
FLEET_AVG_SPEED_KMH=20
FLEET_DEPOT_LAT=23.8069
FLEET_DEPOT_LNG=90.3687
# Route-search budget in seconds for plans requested from the UI.  The solver
# treats this as an upper bound and only starts an improvement round it can
# finish, so raising it trades responsiveness for plan quality and can never
# overrun.  Published results come from the experiment scripts, which call the
# solver directly with their own (larger) budget -- not from these endpoints.
FLEET_PLAN_BUDGET_S=2.0
# Per-solver budget for the comparison endpoint; the page cost is this times the
# number of solvers requested.
FLEET_COMPARE_BUDGET_S=1.0

# ---- Traffic --------------------------------------------------------------
# synthetic (deterministic, reproducible) | live (HTTP feed, falls back to synthetic)
TRAFFIC_PROVIDER=synthetic
# Placeholders: {lat} {lng} {key}, plus {time} (ISO 8601 UTC) or {epoch} (Unix
# seconds) if and only if the endpoint accepts a departure time.  Including one
# tells the adapter it may ask about instants other than now.
TRAFFIC_API_URL=
TRAFFIC_API_KEY=
# Without a departure-time placeholder the feed is a nowcast, so its readings are
# used only for instants this many hours from the wall clock; further-out
# departure times are costed on the synthetic surface instead.
TRAFFIC_LIVE_VALIDITY_H=0.5

# ---- Audit ledger ---------------------------------------------------------
AUDIT_LEDGER_ENABLED=true
AUDIT_BLOCK_SIZE=64
# Optional HMAC secret; when set, every ledger entry is additionally signed.
AUDIT_HMAC_KEY=

# ---- Frontend (frontend/.env.local) ---------------------------------------
# VITE_GOOGLE_MAPS_API_KEY=your-browser-key-here
